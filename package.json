{
  "name": "react-forge-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Example-driven React patterns for Vite, Next.js, server state, UI state, grids, realtime events, background jobs, and notifications.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --filter demo-vite dev",
    "dev:lan": "corepack pnpm --filter demo-vite dev:lan",
    "tunnel": "cloudflared tunnel --url http://127.0.0.1:5174",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter demo-vite test:e2e",
    "format": "prettier --write .",
    "scaffold": "pnpm --filter create-react-forge-kit start",
    "build:demo": "corepack pnpm --filter demo-vite build",
    "deploy:cloudflare": "corepack pnpm build:demo && wrangler pages deploy apps/demo-vite/dist --project-name react-forge-kit"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.0",
    "postcss": "^8.5.4",
    "prettier": "^3.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.1",
    "wrangler": "^4.49.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,css}": [
      "prettier --write"
    ]
  }
}
